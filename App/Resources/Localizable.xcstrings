    "Create a draft GitHub Release %@ (tagged on %@ when published)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entwurf des GitHub Release %1$@ erstellen (Tag auf %2$@ beim Veröffentlichen)"
