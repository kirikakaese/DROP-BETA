    "Public": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffentlich"
          }
        }
      }
    },
    "Remove from DROP": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus DROP entfernen"
          }
        }
      }
    },
    "Repository": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Repository"
          }
        }
      }
    },
    "Review or revoke DROP's access on GitHub": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DROPs Zugriff auf GitHub prüfen oder widerrufen"
          }
        }
      }
    },
    "Scoop Bucket": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scoop-Bucket"
          }
        }
      }
    },
    "Select a Project": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Projekt"
          }
        }
      }
    },
    "Set DROP_OAUTH_CLIENT_ID in Config/Local.xcconfig as described in SETUP.md.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze DROP_OAUTH_CLIENT_ID in Config/Local.xcconfig wie in SETUP.md beschrieben."
          }
        }
      }
    },
    "Sign In Again": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut anmelden"
          }
        }
      }
    },
    "Sign In with GitHub": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit GitHub anmelden"
          }
        }
      }
    },
    "Sign In with GitHub…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit GitHub anmelden …"
          }
        }
      }
    },
    "Sign Out": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abmelden"
          }
        }
      }
    },
    "Sign in again to keep using DROP with GitHub.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich erneut an, um DROP weiter mit GitHub zu verwenden."
          }
        }
      }
    },
    "Sign in with GitHub in Settings → Account.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich unter Einstellungen → Account mit GitHub an."
          }
        }
      }
    },
    "Sign in with GitHub to add your repositories.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich mit GitHub an, um deine Repositories hinzuzufügen."
          }
        }
      }
    },
    "Signing in was cancelled on GitHub.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung wurde auf GitHub abgebrochen."
          }
        }
      }
    },
    "Signing in with GitHub didn't work.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung mit GitHub hat nicht funktioniert."
          }
        }
      }
    },
    "Something went wrong.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas ist schiefgelaufen."
          }
        }
      }
    },
    "Source Code": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quellcode"
          }
        }
      }
    },
    "Status": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Status"
          }
        }
      }
    },
    "The sign-in code expired before it was approved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anmeldecode ist abgelaufen, bevor er bestätigt wurde."
          }
        }
      }
    },
    "This build has no GitHub Client ID, so it can't sign in. See SETUP.md.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Build hat keine GitHub-Client-ID und kann sich deshalb nicht anmelden. Siehe SETUP.md."
          }
        }
      }
    },
    "This build of DROP has no GitHub Client ID.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Build von DROP hat keine GitHub-Client-ID."
          }
        }
      }
    },
    "Try signing in again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuche, dich erneut anzumelden."
          }
        }
      }
    },
    "Version": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Version"
          }
        }
      }
    },
    "Visibility": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichtbarkeit"
          }
        }
      }
    },
    "Wait a few minutes and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warte ein paar Minuten und versuche es erneut."
          }
        }
      }
    },
    "Waiting for you to approve DROP on GitHub…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warte darauf, dass du DROP auf GitHub bestätigst …"
          }
        }
      }
    },
    "You're not signed in to GitHub.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist nicht bei GitHub angemeldet."
          }
        }
      }
    },
    "Your GitHub session has ended.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine GitHub-Sitzung ist abgelaufen."
          }
        }
      }
    },
    "Your GitHub session has ended. Sign in again to keep using DROP with GitHub.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine GitHub-Sitzung ist abgelaufen. Melde dich erneut an, um DROP weiter mit GitHub zu verwenden."
          }
        }
      }
    },
    "Your tokens are kept in the Keychain and never written anywhere else.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Tokens werden im Schlüsselbund aufbewahrt und nirgendwo sonst gespeichert."
          }
        }
      }
    },
    "npm": {
      "shouldTranslate": false
    },
    "owner/name or github.com address": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "owner/name oder github.com-Adresse"
          }
        }
      }
    },
    "“%@” is not a GitHub repository.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist kein GitHub-Repository."
          }
        }
      }
    }
  },
  "version": "1.0"
}
