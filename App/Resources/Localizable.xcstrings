{
  "sourceLanguage": "en",
  "strings": {
    "%@ %@ stopped at “%@”.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ wurde bei „%3$@“ angehalten."
          }
        }
      }
    },
    "%@ (new)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (neu)"
          }
        }
      }
    },
    "%@ already does this. If DROP does it too, they will overwrite each other.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ erledigt das bereits. Wenn DROP es auch tut, überschreiben sie sich gegenseitig."
          }
        }
      }
    },
    "%@ already writes %@, so DROP leaves it alone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ schreibt %2$@ bereits, deshalb lässt DROP die Datei in Ruhe."
          }
        }
      }
    },
    "%@ creates the GitHub Release on tag push. DROP pushes the tag and watches.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ erstellt das GitHub Release beim Tag-Push. DROP pusht den Tag und beobachtet."
          }
        }
      }
    },
    "%@ creates the GitHub Release. DROP pushes the tag, starts %@ and watches.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ erstellt das GitHub Release. DROP pusht den Tag, startet %2$@ und beobachtet."
          }
        }
      }
    },
    "%@ didn't finish within an hour.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist nicht innerhalb einer Stunde fertig geworden."
          }
        }
      }
    },
    "%@ does this (found “%@”). DROP watches and verifies.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ erledigt das (gefunden: „%2$@“). DROP beobachtet und prüft."
          }
        }
      }
    },
    "%@ does this. DROP watches and verifies.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
