    },
    "OK": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "Open GitHub": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub öffnen"
          }
        }
      }
    },
    "Permissions": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechtigungen"
          }
        }
      }
    },
    "Plan the next drop of this project": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den nächsten Drop dieses Projekts planen"
          }
        }
      }
    },
    "Private": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Privat"
          }
        }
      }
    },
    "Project": {
      "localizations": {
        "de": {
