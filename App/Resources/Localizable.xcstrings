{
  "sourceLanguage": "en",
  "strings": {
    "%@ is already in your projects.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist bereits in deinen Projekten."
          }
        }
      }
    },
    "About %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über %@"
          }
        }
      }
    },
    "Account": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Account"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinzufügen"
          }
        }
      }
    },
    "Add Project": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Projekt hinzufügen"
          }
        }
      }
    },
    "Add Project…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Projekt hinzufügen …"
          }
        }
      }
    },
    "Add a GitHub repository": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein GitHub-Repository hinzufügen"
          }
        }
      }
    },
    "Add a repository to start dropping.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge ein Repository hinzu, um mit dem Droppen zu beginnen."
          }
        }
      }
    },
    "Added": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinzugefügt"
          }
        }
      }
    },
    "Archived": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Archiviert"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        }
      }
    },
    "Check your internet connection and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe deine Internetverbindung und versuche es erneut."
          }
        }
      }
    },
    "Choose a project in the sidebar to see its drops.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Projekt in der Seitenleiste, um seine Drops zu sehen."
          }
        }
      }
    },
    "Copy Code": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Code kopieren"
          }
        }
      }
    },
    "Create tags, GitHub Releases, assets and pull requests in public and private repositories.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tags, GitHub Releases, Assets und Pull Requests in öffentlichen und privaten Repositories erstellen."
          }
        }
      }
    },
    "DROP asks for workflow access only when you let it add a release workflow to a repository.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP fragt nach Workflow-Zugriff nur, wenn du es einen Release-Workflow zu einem Repository hinzufügen lässt."
          }
        }
      }
    },
    "DROP built an invalid GitHub request.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP hat eine ungültige GitHub-Anfrage erstellt."
          }
        }
      }
    },
    "DROP could not open its project list.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP konnte seine Projektliste nicht öffnen."
          }
        }
      }
    },
    "DROP could not reach GitHub.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP konnte GitHub nicht erreichen."
          }
        }
      }
    },
    "DROP could not use the Keychain.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP konnte den Schlüsselbund nicht verwenden."
          }
        }
      }
    },
    "DROP is using a temporary list for now, so projects you add are not kept. Quit and reopen DROP to try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP verwendet vorerst eine temporäre Liste, hinzugefügte Projekte werden also nicht gespeichert. Beende DROP und öffne es erneut, um es noch einmal zu versuchen."
          }
        }
      }
    },
    "DROP: drop new versions to GitHub Releases and package registries.\nReleased under the GNU General Public License v3.0.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP: neue Versionen als GitHub Releases und in Paket-Registries droppen.\nVeröffentlicht unter der GNU General Public License v3.0."
          }
        }
      }
    },
    "Default Branch": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard-Branch"
          }
        }
      }
    },
    "Description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibung"
          }
        }
      }
    },
    "Device flow is turned off for DROP's OAuth App on GitHub.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Device Flow ist für DROPs OAuth-App auf GitHub ausgeschaltet."
          }
        }
      }
    },
    "Drop": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop"
          }
        }
      }
    },
    "Drop v%@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop v%@"
          }
        }
      }
    },
    "Drop…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop…"
          }
        }
      }
    },
    "Enter it as owner/name or paste its github.com address.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib es als owner/name ein oder füge seine github.com-Adresse ein."
          }
        }
      }
    },
    "Enter this code on GitHub to let DROP use your account:": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib diesen Code auf GitHub ein, damit DROP deinen Account verwenden darf:"
          }
        }
      }
    },
    "General": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Allgemein"
          }
        }
      }
    },
    "GitHub": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub"
          }
        }
      }
    },
    "GitHub Container Registry": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Container Registry"
          }
        }
      }
    },
    "GitHub can't find this repository anymore. It may be deleted, or you lost access.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub findet dieses Repository nicht mehr. Es wurde vielleicht gelöscht, oder du hast keinen Zugriff mehr."
          }
        }
      }
    },
    "GitHub couldn't find that repository, or your account can't see it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub hat dieses Repository nicht gefunden, oder dein Account kann es nicht sehen."
          }
        }
      }
    },
    "GitHub doesn't know this build's Client ID.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub kennt die Client-ID dieses Builds nicht."
          }
        }
      }
    },
    "GitHub refused the request (HTTP %lld).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub hat die Anfrage abgelehnt (HTTP %lld)."
          }
        }
      }
    },
    "GitHub sent an answer DROP doesn't understand.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub hat eine Antwort geschickt, die DROP nicht versteht."
          }
        }
      }
    },
    "GitHub's rate limit for your account is used up.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHubs Rate-Limit für deinen Account ist aufgebraucht."
          }
        }
      }
    },
    "Homebrew Tap": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew-Tap"
          }
        }
      }
    },
    "Make sure your login keychain is unlocked, then try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle sicher, dass dein Anmeldeschlüsselbund entsperrt ist, und versuche es erneut."
          }
        }
      }
    },
    "No Projects": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Projekte"
          }
