      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP erledigt das."
          }
        }
      }
    },
    "DROP is using a temporary list for now, so projects you add are not kept. Quit and reopen DROP to try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP verwendet vorerst eine temporäre Liste, hinzugefügte Projekte werden also nicht gespeichert. Beende DROP und öffne es erneut, um es noch einmal zu versuchen."
          }
        }
      }
    },
    "DROP never changes a file another workflow writes. Betas and drafts are left out.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP ändert nie eine Datei, die ein anderer Workflow schreibt. Betas und Entwürfe bleiben außen vor."
          }
        }
      }
    },
    "DROP opens a pull request adding %@. Replace its build step before merging.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP öffnet einen Pull Request, der %@ hinzufügt. Ersetze den Build-Schritt vor dem Mergen."
          }
        }
      }
    },
    "DROP starts %@ on each tag.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP startet %@ bei jedem Tag."
          }
        }
      }
    },
    "DROP starts it on the tag once the GitHub Release exists. DROP never holds a registry token.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP startet ihn auf dem Tag, sobald das GitHub Release existiert. DROP hält nie ein Registry-Token."
          }
        }
      }
    },
    "DROP updates %@ in %@ through a pull request.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP aktualisiert %1$@ in %2$@ über einen Pull Request."
          }
        }
      }
    },
    "DROP: drop new versions to GitHub Releases and package registries.\nReleased under the GNU General Public License v3.0.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP: neue Versionen als GitHub Releases und in Paket-Registries droppen.\nVeröffentlicht unter der GNU General Public License v3.0."
          }
        }
      }
    },
